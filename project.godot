; Engine configuration file.
; Island Royale - offline single-player battle royale vs bots.

config_version=5

[application]

config/name="Island Royale"
config/description="Offline single-player battle royale against AI bots."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.04, 0.07, 0.1, 1)
boot_splash/show_image=false

[autoload]

InputState="*res://scripts/input_state.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.09, 0.13, 1)
